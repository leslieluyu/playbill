---
import { mkdirSync, writeFileSync } from "node:fs";
import path from "node:path";
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Bi from "../components/Bi.astro";
import ShowCard from "../components/ShowCard.astro";
import { formEn, lists as listCopy, placeEn, yearsEn } from "../i18n";
import { buildTagGroups, tagsForWork } from "../lib/tags";
import {
  buildYearNav,
  chartTag,
  chartsForList,
  decadeOfYear,
  kjYearFromSection,
  usesYearNav,
} from "../lib/list-charts";

export async function getStaticPaths() {
  const lists = await getCollection("lists");
  return lists.map((list) => ({ params: { list: list.id }, props: { list } }));
}

const { list } = Astro.props;
const meta = list.data;
const copy = listCopy[list.id];
if (!copy) throw new Error(`missing English copy for ${list.id}`);

const useTags = list.id === "criterion-spine" || list.id === "afi-100-movies";
const useYearsNav = usesYearNav(list.id);
const useChartTags = useYearsNav;
const listCharts = chartsForList(list.id);
const linkPeople = list.id !== "criterion-spine";
const featuredLimit = list.id === "afi-100-movies" ? 100 : 0;
// Large catalogs: keep plots/场刊 out of the HTML and hydrate on scroll.
const lazyExtras =
  list.id === "criterion-spine" ||
  list.id === "afi-100-movies" ||
  list.id === "kinema-junpo-ten" ||
  useYearsNav;

const rows = await Promise.all(
  meta.entries.map(async (e) => {
    const work = await getEntry(e.work);
    if (!work) throw new Error(`${list.id}: unknown work ${e.work.id}`);
    const tags = useTags ? tagsForWork(work.data) : [];
    const kjYear = kjYearFromSection(e.section);
    const listChart = chartTag(e.chart, list.id);
    return {
      ...e,
      section: e.section ?? "all",
      work: work.data,
      id: work.id,
      tags,
      kjYear,
      decade: kjYear != null ? decadeOfYear(kjYear) : undefined,
      listChart,
    };
  }),
);
rows.sort((a, b) => a.rank - b.rank);
const primaryRows = featuredLimit > 0 ? rows.filter((r) => r.rank <= featuredLimit) : rows;
const extraRows = featuredLimit > 0 ? rows.filter((r) => r.rank > featuredLimit) : [];

const sectionDefs = meta.sections.length
  ? meta.sections
  : [{ id: "all", name: "全部", blurb: "", color: "#5f5a52" }];
const sectionIds = new Set(sectionDefs.map((s) => s.id));
for (const r of rows) {
  if (!sectionIds.has(r.section)) throw new Error(`${list.id}: ${r.id} has unknown section ${r.section}`);
}
const sectionOf = Object.fromEntries(sectionDefs.map((s) => [s.id, s]));
const sections = sectionDefs.map((s) => ({
  ...s,
  en: copy.sections[s.id] ?? { name: s.name, blurb: s.blurb },
  rows: rows.filter((r) => r.section === s.id),
}));
const tagGroups = useTags ? buildTagGroups(rows.map((r) => r.tags)) : [];
const yearNav = useYearsNav
  ? buildYearNav(rows.map((r) => r.kjYear).filter((y): y is number => y != null)).map((d) => ({
      ...d,
      entryCount: rows.filter((r) => r.decade === d.decade).length,
    }))
  : [];
const chartTagCounts = useChartTags
  ? Object.fromEntries(
      listCharts.map((c) => [c.id, rows.filter((r) => r.chart === c.id).length] as const),
    )
  : {};
const defaultDecade = yearNav[0]?.decade;
const years = rows.flatMap((r) => r.work.years.match(/\d{4}/g) ?? []).map(Number);
const span = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : "";
const isTv = meta.kind === "tv";
const noun = isTv ? "剧" : "片";
const creatorLabel = isTv ? "主创" : "导演";
const rankPad = list.id === "criterion-spine" ? 3 : 2;
const pad = (n: number) => String(n).padStart(rankPad, "0");
const rankDigits = list.id === "criterion-spine" ? Math.max(rankPad, ...rows.map((r) => pad(r.rank).length)) : 2;
const rankHintZh = list.id === "criterion-spine" ? "编号如 065" : "名次如 27";
const rankWordZh = list.id === "criterion-spine" ? "编号" : "名次";

const fetched = rows.flatMap((r) => Object.values(r.work.ratings).map((x) => x?.fetchedAt ?? ""));
const ratedOn = fetched.length ? fetched.sort().at(-1)!.slice(0, 7) : "";

function blob(r: (typeof rows)[number]) {
  // Keep this small: it is inlined on every article and dominated first-load HTML size.
  // Search is for title / people / rank, not full plot or 看点 text.
  const w = r.work;
  const section = sectionOf[r.section];
  const en = copy.sections[r.section];
  return [
    r.rank,
    pad(r.rank),
    section.name,
    en?.name,
    w.zh,
    w.en,
    w.original,
    ...w.alias,
    ...w.creators.flatMap((p) => [p.zh, p.en]),
    ...w.writers.flatMap((p) => [p.zh, p.en]),
    ...w.cast.flatMap((p) => [p.zh, p.en]),
    w.place,
    placeEn(w.place),
    w.form,
    formEn(w.form),
    // Tag ids already sit on data-tags; skip bilingual tag labels here on Criterion.
    ...(useTags ? [] : r.tags.flatMap((t) => [t.zh, t.en])),
    r.kjYear,
    r.listChart?.zh,
    r.listChart?.en,
    r.position,
    r.decade,
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
}

// Criterion list is ~1250 films: keep plots/场刊 out of the HTML and hydrate on scroll.
type Extras = { plot?: string; plotEn?: string; playbill?: string; playbillEn?: string };
let extrasUrl: string | undefined;
if (lazyExtras) {
  const extras: Record<string, Extras> = {};
  for (const r of rows) {
    const w = r.work;
    const row: Extras = {};
    if (w.plot) row.plot = w.plot;
    if (w.plotEn) row.plotEn = w.plotEn;
    if (w.playbill) row.playbill = w.playbill;
    if (w.playbillEn) row.playbillEn = w.playbillEn;
    if (Object.keys(row).length) extras[String(r.rank)] = row;
  }
  // Astro copies public/ before page render, so also write into dist/ for this build.
  const payload = JSON.stringify(extras);
  for (const dir of [path.join(process.cwd(), "public", list.id), path.join(process.cwd(), "dist", list.id)]) {
    mkdirSync(dir, { recursive: true });
    writeFileSync(path.join(dir, "extras.json"), payload);
  }
  extrasUrl = `/${list.id}/extras.json`;
}
---

<Base titleZh={`${meta.title} · 场刊`} titleEn={`${copy.title} · Playbill`} description={meta.dek}>
  <header class="mast">
    <div class="wrap">
      <p class="kicker"><Bi zh={meta.kicker} en={copy.kicker} /></p>
      <h1><Bi zh={meta.title} en={copy.title} /></h1>
      <p class="dek"><Bi zh={meta.dek} en={copy.dek} /></p>
      <ul class="facts">
        <li>
          <b>{featuredLimit ? featuredLimit : rows.length}</b>
          <span>
            {featuredLimit ? (
              <Bi zh="部正式入选" en="official picks" />
            ) : (
              <Bi zh={`部入选${noun}目`} en={isTv ? "shows" : "films"} />
            )}
          </span>
        </li>
        {featuredLimit > 0 && (
          <li>
            <b>{rows.length}</b>
            <span><Bi zh="部候选名单" en="ballot nominees" /></span>
          </li>
        )}
        {span && (
          <li>
            <b>{span}</b>
            <span><Bi zh="名单所跨年份" en="years spanned" /></span>
          </li>
        )}
        {meta.sections.length > 0 && (
          <li>
            <b>{sections.length}</b>
            <span><Bi zh="个阅读分区" en="sections" /></span>
          </li>
        )}
        {useTags && (
          <li>
            <b>{tagGroups.reduce((n, g) => n + g.tags.length, 0)}</b>
            <span><Bi zh="个筛选标签" en="filter tags" /></span>
          </li>
        )}
        {useYearsNav && (
          <li>
            <b>{yearNav.length}</b>
            <span><Bi zh="个年代" en="decades" /></span>
          </li>
        )}
      </ul>
    </div>
  </header>

  <div class="finder" data-rank-pad={rankPad} style={`--rank-digits:${rankDigits}`}>
    <div class="wrap finder-inner">
      <div class="search">
        <div class="search-head">
          <label for="q"><Bi zh="页内搜索" en="Search this page" /></label>
          <button type="button" class="back-top" id="back-top" hidden>
            <Bi zh="回顶部" en="Top" />
          </button>
        </div>
        <input
          id="q"
          type="search"
          placeholder={`${noun}名、${isTv ? "主演、主创" : "导演、主演"}，或${rankHintZh}`}
          data-ph-zh={`${noun}名、${isTv ? "主演、主创" : "导演、主演"}，或${rankHintZh}`}
          data-ph-en={copy.search}
          autocomplete="off"
          enterkeyhint="search"
        />
        <div class="suggest" id="suggest" role="listbox"></div>
        <p class="status" id="status" data-found-zh="找到 {n} 部。回车定位到第一部，或从列表点选。" data-found-en={copy.found} data-none-zh="没有匹配。" data-none-en={copy.none}>
          <span class="zh">{`输入后回车，或点选结果跳到该${noun}。`}</span>
          <span class="en">{copy.idle}</span>
        </p>
      </div>
    </div>
  </div>

  <div
    class="wrap shell"
    style={`--rank-digits:${rankDigits}`}
    data-extras-url={extrasUrl}
    data-long-list={rows.length > 800 ? "" : undefined}
    data-featured-limit={featuredLimit || undefined}
    data-catalog-total={featuredLimit ? rows.length : undefined}
  >
    {
      useYearsNav ? (
        <nav class="years" id="nav" data-mode="years" data-default-decade={defaultDecade}>
          <div class="years-head">
            <p><Bi zh="年代" en="Years" /></p>
            <button type="button" class="tags-clear" id="tags-clear" hidden>
              <Bi zh="清除" en="Clear" />
            </button>
          </div>
          <button type="button" data-section="all" data-name-zh="全部" data-name-en="All" aria-current="true">
            <span class="name">
              <Bi zh="全部" en="All" />
            </span>
            <em>{rows.length}</em>
          </button>
          {yearNav.map((d) => (
            <div class="year-block" data-decade={d.decade}>
              <button
                type="button"
                class="decade"
                data-section={`d${d.decade}`}
                data-name-zh={`${d.decade}年代`}
                data-name-en={`${d.decade}s`}
                aria-expanded={d.decade === defaultDecade ? "true" : "false"}
              >
                <span class="name">
                  <Bi zh={`${d.decade}年代`} en={`${d.decade}s`} />
                </span>
                <em>{d.entryCount}</em>
              </button>
              <div class="year-list" hidden={d.decade !== defaultDecade ? true : undefined}>
                {d.years.map((y) => {
                  const n = rows.filter((r) => r.kjYear === y).length;
                  return (
                    <button type="button" data-section={`y${y}`} data-name-zh={`${y}年度`} data-name-en={String(y)}>
                      <span class="name">
                        <Bi zh={String(y)} en={String(y)} />
                      </span>
                      <em>{n}</em>
                    </button>
                  );
                })}
              </div>
            </div>
          ))}
          <div class="chart-tags">
            <p><Bi zh="榜单" en="Chart" /></p>
            {listCharts.filter((c) => chartTagCounts[c.id] > 0).map((c) => (
              <button
                type="button"
                data-tag={`chart:${c.id}`}
                data-group="chart"
                data-name-zh={c.zh}
                data-name-en={c.en}
                aria-pressed="false"
              >
                <span class="name">
                  <Bi zh={c.zh} en={c.en} />
                </span>
                <em>{chartTagCounts[c.id]}</em>
              </button>
            ))}
          </div>
        </nav>
      ) : useTags ? (
        <nav class="tags" id="nav" data-mode="tags">
          <div class="tags-head">
            <p><Bi zh="标签" en="Tags" /></p>
            <button type="button" class="tags-clear" id="tags-clear" hidden>
              <Bi zh="清除" en="Clear" />
            </button>
          </div>
          {tagGroups.map((g) => (
            <div class="tag-group" data-group={g.id} style={`--tag:${g.color}`}>
              <h3>
                <Bi zh={g.zh} en={g.en} />
              </h3>
              <div class="tag-list">
                {g.tags.map((t) => (
                  <button
                    type="button"
                    data-tag={t.id}
                    data-group={g.id}
                    data-name-zh={t.zh}
                    data-name-en={t.en}
                    aria-pressed="false"
                  >
                    <span class="name">
                      <Bi zh={t.zh} en={t.en} />
                    </span>
                    <em data-count>{t.count}</em>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </nav>
      ) : (
        <nav class="sections" id="nav" data-mode="sections">
          <p><Bi zh="分区" en="Sections" /></p>
          {meta.sections.length > 0 && (
            <button type="button" data-section="all" data-name-zh="全部" data-name-en="All" aria-current="true">
              <span class="swatch" />
              <span class="name">
                <Bi zh="全部" en="All" />
              </span>
              <em>{rows.length}</em>
            </button>
          )}
          {sections.map((s) => (
            <button
              type="button"
              data-section={s.id}
              data-name-zh={s.name}
              data-name-en={s.en.name}
              data-blurb-zh={s.blurb}
              data-blurb-en={s.en.blurb}
              style={`--sec:${s.color}`}
            >
              <span class="swatch" />
              <span class="name">
                <Bi zh={s.name} en={s.en.name} />
              </span>
              <em>{s.rows.length}</em>
            </button>
          ))}
        </nav>
      )
    }

    <main id="main">
      {featuredLimit > 0 && (
        <div class="catalog-toggle" id="catalog-toggle" role="group" aria-label="Catalog scope">
          <button type="button" data-catalog="featured" aria-pressed="true">
            <Bi zh={`百佳 ${featuredLimit}`} en={`Top ${featuredLimit}`} />
          </button>
          <button type="button" data-catalog="all" aria-pressed="false">
            <Bi zh={`全部候选 ${rows.length}`} en={`All ${rows.length} nominees`} />
          </button>
        </div>
      )}
      <div class="topten" id="topten">
        <div class="topten-head">
          <h2><Bi zh="原榜" en="Ranking" /></h2>
          <button type="button" class="topten-more" id="topten-more" aria-expanded="false">
            <span class="when-closed"><Bi zh={`全部 ${featuredLimit || rows.length}`} en={`All ${featuredLimit || rows.length}`} /></span>
            <span class="when-open"><Bi zh="前十" en="Top ten" /></span>
          </button>
        </div>
        <ol>
          {
            primaryRows.map((r, i) => (
              <li class:list={[{ rest: i >= 10 }]}>
                <a href={`#show-${r.rank}`} data-rank={r.rank} style={`--sec:${sectionOf[r.section].color}`}>
                  <span class="n">{pad(r.rank)}</span>
                  <span>
                    {r.work.zh ? (
                      <>
                        <span class="zh">{r.work.zh}</span>
                        <span class="lat">{r.work.en}</span>
                      </>
                    ) : (
                      r.work.en
                    )}
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>

      <p class="empty" id="empty" hidden>
        <Bi
          zh={`没有匹配的${noun}目。可以换${noun}名、人名${useTags || useChartTags ? "、标签" : ""}，或直接输入${rankWordZh}。`}
          en={copy.empty}
        />
      </p>

      <header class="list-section section-intro" id="section-intro" hidden>
        <h2>
          <span class="zh" data-zh></span>
          <span class="en" data-en></span>
          <small data-count></small>
        </h2>
        <p class="blurb">
          <span class="zh" data-blurb-zh></span>
          <span class="en" data-blurb-en></span>
        </p>
      </header>

      {
        primaryRows.map((r) => {
          const sec = sectionOf[r.section];
          const secEn = copy.sections[r.section];
          return (
            <ShowCard
              workId={r.id}
              rank={r.rank}
              section={r.section}
              sectionColor={sec.color}
              sectionName={sec.name}
              sectionNameEn={secEn?.name}
              showSectionInMeta={!useYearsNav && meta.sections.length > 0}
              tags={r.tags}
              work={r.work}
              hook={r.hook}
              hookEn={r.hookEn}
              rankPad={rankPad}
              blob={blob(r)}
              lead={r.rank === 1}
              lazyExtras={lazyExtras}
              linkPeople={linkPeople}
              useTags={useTags}
              listChart={r.listChart}
              kjYear={r.kjYear}
              position={r.position}
              entryNote={r.note}
              decade={r.decade}
              creatorLabel={creatorLabel}
              creatorLabelEn={copy.creator}
            />
          );
        })
      }
      {
        extraRows.length > 0 && (
          <template id="catalog-extra-src">
            {extraRows.map((r) => {
              const sec = sectionOf[r.section];
              const secEn = copy.sections[r.section];
              return (
                <ShowCard
                  workId={r.id}
                  rank={r.rank}
                  section={r.section}
                  sectionColor={sec.color}
                  sectionName={sec.name}
                  sectionNameEn={secEn?.name}
                  showSectionInMeta={!useYearsNav && meta.sections.length > 0}
                  tags={r.tags}
                  work={r.work}
                  hook={r.hook}
                  hookEn={r.hookEn}
                  rankPad={rankPad}
                  blob={blob(r)}
                  catalogExtra
                  lazyExtras={lazyExtras}
                  linkPeople={linkPeople}
                  useTags={useTags}
                  listChart={r.listChart}
                  kjYear={r.kjYear}
                  position={r.position}
                  entryNote={r.note}
                  decade={r.decade}
                  creatorLabel={creatorLabel}
                  creatorLabelEn={copy.creator}
                />
              );
            })}
          </template>
        )
      }
    </main>
  </div>

  <dialog id="poster-view">
    <button type="button" class="x" data-close><Bi zh="关闭" en="Close" /></button>
    <img alt="" width="342" height="513" />
    <p class="cap"></p>
  </dialog>

  <Fragment slot="colophon">
    <p>
      <span class="zh">
        名单{isTv ? "与播出年份" : ""}来自
        <a href={meta.source.url}>{meta.source.name}</a>。中文名取华语地区较通行的译名，搜索同时认常见别名。{creatorLabel}、主演和剧情为依据公开资料做的简要整理。
        {list.id === "criterion-spine"
          ? "「看点」摘自 Criterion 官方影片页短文（目前仅部分编号有，中文为试译）；「场刊」是我们自己的短注，挂在作品上。"
          : list.id === "afi-100-movies"
            ? "前 100 名为 AFI 2007 年正式榜单；其余为当年选票上的其他候选，按选票编号排列。候选名单另见 AFI 官方 ballot PDF。「场刊」是我们自己的短注，挂在作品上，这份榜单里还在补。"
            : list.id === "kinema-junpo-ten"
              ? "榜单类型与旬报年度以豆列评语为准（艺术／娱乐、日本／外国等）。第85回（2011年度）外国电影 Best Ten 第4位、第92回（2018年度）外国电影 Best Ten 第8位在豆列标注暂缺，本站不补条目，仅在此说明。「场刊」是我们自己的短注，挂在作品上，这份榜单里还在补。"
              : useYearsNav && list.id !== "kinema-junpo-ten"
                ? "届次年份与「获奖／提名」以豆瓣电影节获奖页主竞赛最高奖单元为准；左侧按电影节年份筛选。「场刊」是我们自己的短注，挂在作品上，这份榜单里还在补。"
                : isTv
                ? "「场刊」是我们为每部作品写的短注，挂在作品上；这份榜单的原生「看点」日后补。"
                : "「看点」译自《纽约时报》在这篇榜单里为每部电影写的推荐短文，英文模式下显示原文；「场刊」是我们自己的短注，挂在作品上，这份榜单里还在补。"}
      </span>
      <span class="en">
        The list{isTv ? " and the years on air are" : " is"} from <a href={meta.source.url}>{meta.source.name}</a>. {copy.colophon}
      </span>
    </p>
    {
      ratedOn && (
        <p>
          <span class="zh">
            评分取自豆瓣与 IMDb，截至 {ratedOn}。豆瓣按季分开打分，多季剧集显示各季平均分（标「均」，悬停可看各季），评分人数过少的季不计入。
          </span>
          <span class="en">{copy.ratings.replace("{date}", ratedOn)}</span>
        </p>
      )
    }
  </Fragment>
</Base>

<script>
  import { initList } from "../scripts/list";
  initList();
</script>
