---
interface Props {
  id: string;
  zh?: string;
  en: string;
  /** When false, render plain text (keeps huge list pages lighter). */
  linked?: boolean;
}
const { id, zh, en, linked = true } = Astro.props;
---

{
  linked ? (
    <a class="person-link" href={`/people/${id}/`} data-prefetch>
      {zh && <span class="zh">{zh} </span>}
      <span class="lat">{en}</span>
    </a>
  ) : (
    <span class="person-plain">
      {zh && <span class="zh">{zh} </span>}
      <span class="lat">{en}</span>
    </span>
  )
}
