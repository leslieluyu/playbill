{
  "name": "playbill",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "verify": "node --no-warnings scripts/verify-lists.mjs",
    "verify:dist": "node --no-warnings scripts/verify-lists.mjs --dist",
    "prebuild": "node --no-warnings scripts/verify-lists.mjs",
    "postbuild": "node --no-warnings scripts/verify-lists.mjs --dist",
    "preview": "astro preview",
    "db": "node --no-warnings scripts/db.mjs",
    "seed": "node --no-warnings scripts/seed-list.mjs",
    "great-directors-seed": "python3 scripts/build-great-directors-seed.py",
    "festival-seed": "node --no-warnings --env-file=.env scripts/build-festival-seed.mjs",
    "festival-enrich": "node --no-warnings --env-file=.env scripts/festival-enrich.mjs",
    "fill-plots": "node --no-warnings --env-file=.env scripts/fill-plots.mjs",
    "tmdb": "node --no-warnings --env-file=.env scripts/tmdb.mjs",
    "people": "node --no-warnings --env-file=.env scripts/people.mjs",
    "imdb": "node --no-warnings scripts/imdb.mjs",
    "douban": "node --no-warnings --env-file=.env scripts/douban.mjs",
    "criterion": "node --no-warnings scripts/fetch-criterion.mjs",
    "criterion-blurbs": "node --no-warnings scripts/fetch-criterion-blurbs.mjs",
    "criterion-blurbs:import": "node --no-warnings scripts/import-criterion-blurbs.mjs",
    "criterion-blurbs:zh": "node --no-warnings scripts/translate-criterion-blurbs.mjs",
    "people-awards": "node --no-warnings --env-file=.env scripts/fetch-person-awards.mjs"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "undici": "^8.12.1"
  }
}
